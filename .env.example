DATABASE_URL="postgresql://user:password@localhost:5432/ultravip?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""

# Optional: transactional email (Resend). Leave empty to disable real sending;
# communications will still be logged in the CRM without actually being sent.
RESEND_API_KEY=""
EMAIL_FROM="ULTRAVIP <no-reply@ultravip.example>"
